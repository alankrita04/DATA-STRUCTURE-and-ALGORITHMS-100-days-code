//Problem: Given n real numbers in [0,1), sort using bucket sort algorithm.

#include <stdio.h>
#include <stdlib.h>

// Node for linked list (for buckets)
typedef struct Node {
    float data;
    struct Node* next;
} Node;

// Insert in sorted order (Insertion Sort for bucket)
Node* insertSorted(Node* head, float value) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    newNode->data = value;
    newNode->next = NULL;

    if (head == NULL || value < head->data) {
        newNode->next = head;
        return newNode;
    }

    Node* current = head;
    while (current->next != NULL && current->next->data < value) {
        current = current->next;
    }

    newNode->next = current->next;
    current->next = newNode;

    return head;
}

int main() {
    int n;
    scanf("%d", &n);

    float arr[n];

    // Input array
    for (int i = 0; i < n; i++) {
        scanf("%f", &arr[i]);
    }

    // Create buckets
    Node* buckets[n];
    for (int i = 0; i < n; i++) {
        buckets[i] = NULL;
    }

    // Distribute elements into buckets
    for (int i = 0; i < n; i++) {
        int index = (int)(arr[i] * n); // bucket index
        buckets[index] = insertSorted(buckets[index], arr[i]);
    }

    // Concatenate buckets
    int k = 0;
    for (int i = 0; i < n; i++) {
        Node* current = buckets[i];
        while (current != NULL) {
            arr[k++] = current->data;
            current = current->next;
        }
    }

    // Print sorted array
    for (int i = 0; i < n; i++) {
        printf("%.2f ", arr[i]);
    }

    return 0;
}
